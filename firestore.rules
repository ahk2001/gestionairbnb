rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // Funções de Autorização & Segurança no Servidor
    // ========================================================================

    // Verifica se um e-mail pertence aos administradores raiz
    function isRootOwnerEmail(email) {
      return email != null &&
             (email.lower() == 'gestionairbnb2026@gmail.com' ||
              email.lower() == 'gestao.airbnb.portugal@gmail.com' ||
              email.lower() == 'akreuch2001@gmail.com');
    }

    // Administrador raiz pré-autorizado para bootstrap seguro
    function isRootOwner() {
      return request.auth != null &&
             request.auth.token.email != null &&
             isRootOwnerEmail(request.auth.token.email);
    }

    // Usuário autenticado pelo Google com e-mail verificado
    function isAuthenticated() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email_verified == true;
    }

    // Busca o documento de acesso na allowlist
    function getUserAccess() {
      return get(/databases/$(database)/documents/access/$(request.auth.token.email.lower())).data;
    }

    // Verifica se possui registro ativo na allowlist
    function hasActiveAccess() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/access/$(request.auth.token.email.lower())) &&
             getUserAccess().active == true;
    }

    // Perfil de Proprietário / Gestor
    function isOwner() {
      return isAuthenticated() && (
        isRootOwner() ||
        (hasActiveAccess() && getUserAccess().role == 'owner')
      );
    }

    // Perfil de Colaboradora da Equipe
    function isStaff() {
      return isAuthenticated() &&
             hasActiveAccess() &&
             getUserAccess().role == 'staff';
    }

    // Qualquer usuário autorizado no sistema (Dono ou Equipe ativa)
    function isAuthorizedUser() {
      return isOwner() || isStaff();
    }

    // ========================================================================
    // 1. Controle de Acesso (Allowlist de E-mails)
    // ========================================================================
    match /access/{email} {
      // Usuário pode ler seu próprio documento para saber seu perfil; Dono pode listar todos
      allow get: if isAuthenticated() && (request.auth.token.email.lower() == email.lower() || isOwner());
      allow list: if isOwner();

      // Bootstrap seguro: apenas o root owner pode criar registros de donos raiz.
      // Donos secundários não podem criar ou registrar administradores raiz
      allow create: if (isOwner() && !isRootOwnerEmail(email)) ||
                       (isRootOwner() && request.auth.token.email.lower() == email.lower());

      // Apenas o proprietário pode alterar papéis ou revogar acessos
      // Protege contra exclusão ou modificação dos registros de administradores raiz por donos secundários
      allow update, delete: if isOwner() && (!isRootOwnerEmail(email) || isRootOwner());
    }

    // ========================================================================
    // 2. Configurações Globais & Perfil do Gestor
    // ========================================================================
    match /settings/{docId} {
      allow read: if isAuthorizedUser();
      allow write: if isOwner();
    }

    // ========================================================================
    // 3. Imóveis (JB, VN, HN)
    // ========================================================================
    match /properties/{propId} {
      allow read: if isAuthorizedUser();
      allow write: if isOwner();
    }

    // ========================================================================
    // 4. Estoque & Catálogo de Produtos
    // ========================================================================
    match /products/{productId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser();
      allow delete: if isOwner();
    }

    // ========================================================================
    // 5. Lixeira de Produtos (Até 30 dias)
    // ========================================================================
    match /trashProducts/{trashId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser();
      allow delete: if isOwner();
    }

    // ========================================================================
    // 6. Cadastro de Membros da Equipe
    // ========================================================================
    match /staff/{staffId} {
      allow read: if isAuthorizedUser();
      allow delete: if isOwner();
      // Colaboradora pode registrar seu próprio perfil de equipe
      allow create: if isOwner() || (
        isStaff() &&
        request.resource.data.email != null &&
        request.resource.data.email.lower() == request.auth.token.email.lower()
      );
      // Colaboradora só atualiza o seu próprio perfil, não pode alterar o e-mail nem reativar status se estiver suspenso
      allow update: if isOwner() || (
        isStaff() &&
        resource.data.email != null &&
        resource.data.email.lower() == request.auth.token.email.lower() &&
        (request.resource.data.email == null || request.resource.data.email.lower() == resource.data.email.lower()) &&
        (!('isActive' in request.resource.data) || request.resource.data.isActive == resource.data.isActive)
      );
    }

    // ========================================================================
    // 7. Mural de Recados & Avisos
    // ========================================================================
    match /notes/{noteId} {
      allow read: if isAuthorizedUser();
      // Não permite que colaboradora forje nota com perfil de 'owner'
      allow create: if isOwner() || (
        isStaff() &&
        request.resource.data.authorType != 'owner'
      );
      // Dono pode editar tudo; Colaboradora não altera tipo de autor e, em recados do dono, só pode alternar status de resolução
      allow update: if isOwner() || (
        isStaff() &&
        request.resource.data.authorType == resource.data.authorType &&
        (resource.data.authorType != 'owner' || request.resource.data.content == resource.data.content)
      );
      // Integridade dos avisos: colaboradora só pode apagar notas criadas pela equipe, NUNCA do gestor
      allow delete: if isOwner() || (
        isStaff() &&
        resource.data.authorType != 'owner'
      );
    }

    // ========================================================================
    // 8. Escalas & Calendário de Limpeza
    // ========================================================================
    match /calendar/{eventId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser();
      allow delete: if isOwner();
    }

    // ========================================================================
    // 9. Compras & Comprovantes Fiscais
    // ========================================================================
    match /purchases/{purchaseId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser();
      // Integridade financeira: apenas o proprietário pode apagar comprovantes de compra
      allow delete: if isOwner();
    }

    // ========================================================================
    // 10. Registros de Horas Trabalhadas (Timesheets)
    // ========================================================================
    match /timesheets/{timesheetId} {
      allow read: if isAuthorizedUser();
      // Dono cria qualquer registro; Colaboradora só cria registro atribuído ao seu próprio e-mail (podendo definir status de pagamento)
      allow create: if isAuthorizedUser() && (
        isOwner() ||
        (
          request.resource.data.staffEmail != null &&
          request.resource.data.staffEmail.lower() == request.auth.token.email.lower()
        )
      );
      // Colaboradora só edita o próprio registro existente e não pode mudar a titularidade do e-mail
      allow update: if isOwner() || (
        isStaff() &&
        resource.data.staffEmail != null &&
        resource.data.staffEmail.lower() == request.auth.token.email.lower() &&
        (request.resource.data.staffEmail == null || request.resource.data.staffEmail.lower() == resource.data.staffEmail.lower())
      );
      // Dono pode apagar qualquer registro; colaboradora só pode apagar o seu próprio
      allow delete: if isOwner() || (
        isStaff() &&
        resource.data.staffEmail != null &&
        resource.data.staffEmail.lower() == request.auth.token.email.lower()
      );
    }

    // Bloqueia qualquer outra rota não explicitamente declarada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
